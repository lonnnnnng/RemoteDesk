# RemoteDesk v0.1.2 Linux relay/TURN 环境变量
# Author: long

RD_HTTP_ADDR=:18081
RD_WS_PUBLIC_URL=ws://<PUBLIC_IP_OR_DOMAIN>:18081/ws
RD_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
RD_LOG_LEVEL=info
RD_PROTOCOL_VERSION=1.0

RD_TURN_BIND_ADDR=0.0.0.0:3478
RD_TURN_PUBLIC_IP=<PUBLIC_IPV4>
RD_TURN_PORT=3478
RD_TURN_REALM=remote.desk

# v0.1.2 relay 会向客户端下发这组固定凭据；当前版本不要改成其他值。
RD_TURN_USERNAME=rd
RD_TURN_PASSWORD=rdpass
