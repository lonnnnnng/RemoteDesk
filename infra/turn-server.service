[Unit]
Description=RemoteDesk TURN server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remote_desk
Group=remote_desk
ExecStart=/usr/local/bin/remote-desk-turn-server -config /etc/remote-desk/remote-desk.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/remote-desk
WorkingDirectory=/var/lib/remote-desk

[Install]
WantedBy=multi-user.target
